# PayMatrix Environment Configuration Example
# Copy to .env or export into your environment

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/paylab
SPRING_DATASOURCE_USERNAME=paylab
SPRING_DATASOURCE_PASSWORD=paylab

# Webhook Cryptographic Signing Secret (Required in production)
PAYLAB_WEBHOOK_SIGNING_SECRET=local-dev-only-secret

# Webhook Delivery Worker Configuration
PAYLAB_WEBHOOK_CONNECT_TIMEOUT=2s
PAYLAB_WEBHOOK_REQUEST_TIMEOUT=5s
PAYLAB_WEBHOOK_WORKER_DELAY=1s
PAYLAB_WEBHOOK_CLAIM_SECONDS=30
PAYLAB_WEBHOOK_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Server & Management Port
SERVER_PORT=8080

